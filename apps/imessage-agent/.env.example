IMESSAGE_API_SECRET="change-me-to-a-long-random-string"
WRITERSARCADE_API_URL="http://localhost:3000"

# Optional: cloud iMessage provider. Leave unset to use local Mac Messages.
SPECTRUM_PROJECT_ID=""
SPECTRUM_PROJECT_SECRET=""

# Optional: enable the terminal provider for local testing.
ENABLE_TERMINAL="true"

# Optional: disable the local Mac Messages provider (e.g. for terminal-only testing).
LOCAL_IMESSAGE="true"
