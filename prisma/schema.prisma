// Enhanced Prisma schema - consolidating existing Sequelize models
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal User model - wallet-based preferences only
// Social profiles (username, avatar, bio) fetched from Farcaster at runtime
model User {
  id            String   @id @default(cuid())
  walletAddress String?  @unique // Wallet identity (optional — guests/email users have none)
  email         String?  @unique // Magic-link identity
  guestKey      String?  @unique // Anonymous guest identity (random key in signed cookie)

  // Game generation preferences (user-specific settings)
  preferredModel String  @default("gpt-4o-mini")
  private        Boolean @default(false) // Hide games from public discovery

  // Role management
  isCreator      Boolean @default(false) // User can create/register IP assets
  isAdmin        Boolean @default(false) // Platform admin access

  // Etherfuse fiat onramp credits
  credits              Int      @default(0) // Available credits from fiat purchases
  totalCreditsPurchased Int     @default(0) // Lifetime credits purchased (append-only)

  // Story Protocol Grouping — EvenSplitGroupPool for pooled royalties
  storyGroupIpId String? // Group IP Asset ID for this writer's royalty pool

  // Relations
  games    Game[]
  chats    Chat[]
  sessions Session[]
  orders   Order[]
  payments Payment[]
  
  creditTransactions CreditTransaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

model Game {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String @db.Text
  tagline     String @db.Text
  genre       String
  subgenre    String

  // Game mode: "story" (default) or "wordle" (article-derived word puzzle)
  mode        String @default("story")

  // Visual customization
  primaryColor String?

  // AI generation metadata (consolidated)
  promptName       String  @default("GenerateGame-v2")
  promptText       String? @db.Text
  promptModel      String  @default("gpt-4o-mini")

  // Image generation
  imageUrl         String?  // Generated image URL (Venice AI)
  imagePromptModel String? 
  imagePromptName  String?
  imagePromptText  String? @db.Text
  imageData        Bytes?

  // Music generation  
  musicPromptText      String?
  musicPromptSeedImage String?

  // Mini App specific fields
  articleUrl         String?  // Original article URL (Paragraph)
  articleContext     String?  @db.Text  // Article summary used for game start narrative continuity
  writerCoinId       String?  // Which writer coin was used (e.g., "avc")
  difficulty         String?  // Game difficulty: "easy" or "hard"

  // Encrypted answer/handle storage — Inco (primary) or Story CDR (legacy)
  // Inco: "inco-pending" before mint, then cleared after on-chain storage
  // CDR (legacy): vault UUID for the Wordle answer (provably fair)
  wordleAnswerVaultUuid String?

  // Inco: "inco:<tokenId>" after on-chain storage
  // CDR (legacy): vault UUID for the secret panel system prompt
  promptVaultUuid      String?

  // Source material attribution (preserves original author for Story Protocol & NFT metadata)
  authorParagraphUsername String?  // Original author's Paragraph username (e.g., "fred" from Fred Wilson)
  authorWallet            String?  // Original author's wallet address
  publicationName         String?  // Original publication name
  publicationSummary      String?  // Original publication summary
  subscriberCount         Int?     // Original publication subscriber count
  articlePublishedAt      DateTime?  // Original article publication date
  
  // Ownership and creator attribution
  ownerWallet             String?  // Canonical wallet allowed to manage/mint the game
  ownershipSource         String?  // 'payment_wallet' | 'siwe_user' | 'legacy_creator_wallet'
  creatorWallet           String?  // Public creator attribution / legacy owner fallback
  userWallet              String?  // Connected wallet for IP registration purposes

  // NFT minting fields
  nftTokenId       String?  // ERC-721 token ID
  nftTransactionHash String?  // Transaction hash for mint
  nftMintedAt      DateTime?  // When NFT was minted
  nftContractAddress String? // Contract that minted this game NFT
  nftChainId       Int?     // Chain where this game NFT was minted
  nftMetadataUri   String?  // ERC-721 metadata URI used for the minted token
  gameMetadataUri  String?  // Full game metadata URI for Story/IP provenance

  // Canonical saved artifact manifest for public gallery/NFT views
  artifactManifestUri String?
  artifactSavedAt     DateTime?

  // Story Protocol registration for the game itself
  storyIpId        String?  // Story Protocol IP Asset ID
  storyRegistrationTxHash String?
  storyRegisteredAt DateTime?

  // CDR policy metadata for judge/user-facing lifecycle display
  cdrReadConditionType String?
  cdrVaultedAt     DateTime?

  // Payment tracking
  paymentId        String?
  payment          Payment?  @relation(fields: [paymentId], references: [id])

  // Monetization & Discovery
  playFee          String?   // Fee to play in tokens (BigInt as String)
  featured         Boolean   @default(false)

  // Video upsell tracking
  videoUpsoldAt DateTime?
  videoUpsellStatus String @default("idle") // 'idle' | 'pending' | 'completed' | 'failed'

  // Play tracking — incremented each time a game session completes
  playCount    Int      @default(0)
  lastPlayedAt DateTime? // Last time the game was played

  // Access control
  private Boolean @default(false)

  // NEW: Approval workflow & quality metrics
  approvalStatus String @default("pending") // 'pending' | 'approved' | 'rejected'
  articleFidelityScore Float? // 0-100 semantic match (how well game matches article themes)
  approvedAt DateTime?
  rejectionReason String? @db.Text

  // Inco: secret panel pre-encryption JSON (cleared after on-chain storage)
  secretPanelCiphertext    String? @db.Text
  secretPanelImagePrompt   String? @db.Text // Image generation prompt for the secret panel
  secretPanelGenerated     Boolean @default(false) // Whether secret panel was generated

  // Hypercerts: Impact certificate for creative contribution
  hypercertUri String? // AT Protocol URI (at://did:plc:xxx/org.hypercerts.claim.activity/yyy)
  hypercertCid String? // Content hash for tamper-evidence

  // SuperRare NFT collectible fields
  superrareTokenId   String?   // SuperRare token ID
  superrareContract  String?   // SuperRare contract address
  superrareMintedAt  DateTime? // When SuperRare NFT was minted

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chats Chat[]
  gamesFromArticles GameFromArticle[]
  gamesFromAssets GameFromAsset[]
  feedbacks GameFeedback[]
  playEvents GamePlayEvent[]
  panelRatings PanelRating[]
  artifactPanels GameArtifactPanel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyChallengeSessions DailyChallengeSession[]

  @@map("games")
}

// Resonance event log — 'started' | 'choice' | 'completed' (default keeps legacy rows correct)
model GamePlayEvent {
  id     String   @id @default(cuid())
  gameId String
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  type        String  @default("completed")
  sessionId   String? // Play-session UUID (Session.sessionId)
  panelIndex  Int?    // 1-5, for 'choice'
  choiceIndex Int?    // 1-4, for 'choice'
  choiceText  String? @db.Text
  referrer    String? // ?ref= attribution from embeds
  embedded    Boolean @default(false)

  @@index([gameId, playedAt])
  @@index([playedAt])
  @@index([gameId, type, playedAt])
  @@map("game_play_events")
}

model GameArtifactPanel {
  id String @id @default(cuid())

  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  panelIndex Int
  narrativeText String @db.Text
  imageUrl String?
  imageModel String?
  userChoice String? @db.Text
  audioUrl String?

  // AI-generated video upsell (per panel)
  videoUrl String?      // CDN URL of the generated MP4 (persistent storage)
  videoProvider String? // Provider slug, e.g. "luma" | "fal" | "replicate" | "mock"
  videoModel String?    // Specific model/version used, e.g. "ray-2"
  videoJobId String?    // Provider job id used for polling/status updates
  videoStatus String @default("idle") // 'idle' | 'pending' | 'completed' | 'failed'
  videoError String?    // Failure reason for support/debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, panelIndex])
  @@index([gameId, panelIndex])
  @@index([videoStatus, updatedAt])
  @@map("game_artifact_panels")
}

// NEW: User feedback on games (NPS, fidelity, quality)
model GameFeedback {
  id String @id @default(cuid())
  
  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  userId String?
  
  // NPS: "Would you recommend?" 0-10
  npsScore Int // 0-10
  npsComment String? @db.Text
  
  // Optional: Game quality ratings
  fidelityRating Int? // 1-5 (did game match article?)
  narrativeQuality Int? // 1-5
  engagementScore Int? // 1-5
  
  createdAt DateTime @default(now())
  
  @@unique([gameId, userId, createdAt])
  @@map("game_feedbacks")
}

// NEW: Ratings for individual comic panels
model PanelRating {
  id String @id @default(cuid())
  
  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  panelIndex Int // Which panel (0-4)
  userId String?
  
  rating Int // 1-5 stars
  feedback String? @db.Text // "Image doesn't match narrative"
  
  createdAt DateTime @default(now())
  
  @@unique([gameId, panelIndex, userId])
  @@map("panel_ratings")
}

model Session {
  id        String   @id @default(cuid())
  sessionId String   @unique
  
  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  chats Chat[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("sessions")
}

model Chat {
  id        String   @id @default(cuid())
  parentId  String?
  role      ChatRole
  content   String   @db.Text
  model     String
  
  // Relations
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Self-referential for conversation threading
  parent   Chat?  @relation("ChatThread", fields: [parentId], references: [id])
  children Chat[] @relation("ChatThread")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("chats")
}

enum ChatRole {
  user
  assistant
  system
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  content     String    @db.Text
  author      String?
  publishedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("articles")
}

model Order {
  id           String      @id @default(cuid())
  stripeId     String?     @unique
  amount       Int         // in cents
  currency     String      @default("usd")
  status       OrderStatus @default(pending)
  
  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("orders")
}

enum OrderStatus {
  pending
  completed
  failed
  refunded
}

// Payment tracking for writer coin transactions
model Payment {
  id               String   @id @default(cuid())
  transactionHash  String   @unique  // Blockchain tx hash
  action           String   // 'generate-game' or 'mint-nft'
  amount           Decimal  @db.Decimal(78, 0) // Amount in token smallest unit
  status           String   @default("pending")  // 'pending' | 'verified' | 'failed'
  walletAddress    String?  // Wallet that sent the verified transaction
  chainId          Int?
  
  // Relations
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  writerCoinId     String   // Which coin was used (e.g., "avc")
  
  // Game tracking
  games            Game[]
  
  createdAt        DateTime @default(now())
  verifiedAt       DateTime?
  
  @@map("payments")
}

// New models for WritArcade features

model ContentSource {
  id              String      @id @default(cuid())
  url             String      @unique
  type            ContentType
  title           String?
  author          String?
  
  // Newsletter/blog metadata
  rssUrl          String?
  webhookUrl      String?
  memecoinContract String?    // Base contract address
  tokenSymbol     String?
  tokenDecimals   Int?        @default(18)
  
  // Revenue sharing
  royaltyPercentage Int       @default(10) // percentage to creator
  pricePerGame      Int       @default(100) // tokens required
  
  // Scraping config
  autoScrapeFreq    String?   @default("daily")
  lastScrapedAt     DateTime?
  
  // Relations
  articles ProcessedArticle[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("content_sources")
}

enum ContentType {
  newsletter
  blog
  article
  unknown
}

model ProcessedArticle {
  id              String @id @default(cuid())
  originalUrl     String
  title           String?
  author          String?
  content         String @db.Text
  wordCount       Int
  estimatedReadTime Int // in minutes
  publishedAt     DateTime?
  
  // Relations
  sourceId String
  source   ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  // Generated games from this article
  games GameFromArticle[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([sourceId, originalUrl])
  @@map("processed_articles")
}

model GameFromArticle {
  id String @id @default(cuid())
  
  // Relations
  gameId    String
  // Relation back to Game model
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  articleId String
  article   ProcessedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  // User who generated this interpretation
  userId String
  
  // Generation metadata
  generationPrompt String @db.Text
  tokensSpent      Int
  memecoinUsed     String // token symbol
  
  createdAt DateTime @default(now())
  
  @@map("games_from_articles")
}

// Asset Marketplace Models (Phase 6)
model Asset {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  sourceSnippet String?  @db.Text // Provenance: the exact text from which this asset was derived
  type        String   // 'character' | 'mechanic' | 'plot' | 'world' | 'dialog'
  content     String   @db.Text
  genre       String
  tags        String[] @default([])
  
  // Attribution
  articleUrl  String?
  creatorId   String?
  
  // Relations
  games                GameFromAsset[]
  revenues             AssetRevenue[]
  storyRegistration    AssetStoryRegistration?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("assets")
}

model GameFromAsset {
  id String @id @default(cuid())
  
  // Relations
  gameId  String
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  // User who built game from assets
  userId  String
  
  // Composition metadata
  compositionPrompt String @db.Text
  tokensSpent       Int
  
  createdAt DateTime @default(now())
  
  @@unique([gameId, assetId])
  @@map("games_from_assets")
}

model AssetRevenue {
  id String @id @default(cuid())
  
  // Relations
  assetId  String
  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  gameId   String // Game that used this asset (not a foreign key - may be external)
  
  // Revenue tracking
  creatorId       String // Asset creator's wallet
  amount          BigInt // Revenue from this asset usage
  status          String @default("pending") // 'pending' | 'claimed' | 'distributed'
  
  createdAt DateTime @default(now())
  claimedAt DateTime?
  
  @@unique([assetId, gameId])
  @@map("asset_revenues")
}

// Story Protocol Asset Registration (Sprint 4)
model AssetStoryRegistration {
  id String @id @default(cuid())
  
  // Relations
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  // Story Protocol data
  storyIpId       String @unique // IP Asset ID on Story Protocol
  transactionHash String // Registration transaction hash
  blockNumber     Int    // Block where registration was mined
  metadataUri     String // IPFS URI for asset metadata
  
  // License configuration
  licenseTerms Json? // { commercialUse, commercialAttribution, derivatives, derivativeRoyalty }
  
  // Status tracking
  status        String @default("pending") // 'pending' | 'registered' | 'active'
  registeredAt  DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("asset_story_registrations")
}

// Etherfuse fiat onramp credit transactions
model CreditTransaction {
  id        String   @id @default(cuid())
  
  // User who purchased credits
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Order tracking
  etherfuseOrderId String? // Etherfuse's order ID for this transaction
  externalRef      String? // Client-side idempotency key
  
  // Amounts
  fiatAmount   Int    // Amount in fiat cents (e.g., USD cents)
  fiatCurrency String @default("USD") // Fiat currency code
  creditAmount Int    // Credits awarded (1 credit = $0.10 USD)
  
  // Status tracking
  status    CreditTransactionStatus @default(pending)
  metadata  Json? // Additional data: payment method, kyc status, etc.
  
  createdAt DateTime @default(now())
  completedAt DateTime?
  
  @@index([userId])
  @@index([etherfuseOrderId])
  @@map("credit_transactions")
}

enum CreditTransactionStatus {
  pending
  completed
  failed
  refunded
}

// Farcaster Mini App notification tokens for push notifications
// Stored per-fid so we can send notifications when new games are published
model FarcasterNotificationToken {
  id        String   @id @default(cuid())
  fid       Int      // Farcaster user ID (from webhook header)
  token     String   // Notification token from Farcaster SDK
  url       String?  // Notification webhook URL
  enabled   Boolean  @default(true) // false when user disables or removes mini app

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fid, token])
  @@index([fid])
  @@map("farcaster_notification_tokens")
}

// ── Daily Challenge (Inco confidential game sessions + BasePaint crossover) ──

model DailyChallenge {
  id          String   @id @default(cuid())
  day         Int      @unique // 1-based day number (matches BasePaint day)
  sourceType  String   // "article" | "marketing-copy" | "basepaint"
  sourceUrl   String?  // article URL or BasePaint day URL
  basePaintDay Int?    // BasePaint day number if sourceType = "basepaint"
  theme       String?  // BasePaint theme name or article title
  palette     String[] // color palette (BasePaint) or empty
  canvasUrl   String?  // BasePaint canvas image URL
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sessions    DailyChallengeSession[]

  @@map("daily_challenges")
}

model DailyChallengeSession {
  id                  String   @id @default(cuid())
  challengeId         String
  gameId              String
  playerAddress       String?
  incoSessionId       String?  @unique // on-chain session ID from DailyChallengeVault
  score               Int?     // revealed score (null until reveal)
  rank                Int?
  revealed            Boolean  @default(false)
  revealedModifierIds Int[]   // 5 modifier IDs revealed at the finale
  revealedAt          DateTime?

  createdAt   DateTime @default(now())

  challenge   DailyChallenge @relation(fields: [challengeId], references: [id])
  game        Game            @relation(fields: [gameId], references: [id])

  @@index([challengeId, score(sort: Desc)])
  @@map("daily_challenge_sessions")
}
