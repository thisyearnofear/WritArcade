# Production Environment Variables for Vercel
# Copy these to your Vercel project settings: https://vercel.com/[your-project]/settings/environment-variables

# Site URL (REQUIRED for social media sharing)
NEXT_PUBLIC_SITE_URL="https://writarcade.vercel.app"
NEXT_PUBLIC_ANALYTICS_ENDPOINT="/api/analytics"

# Database (REQUIRED)
# For serverless (Vercel), use connection pooling:
# Example with Neon: postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Direct database URL for migrations (bypasses connection pooler)
# DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# AI Services (REQUIRED for game generation)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
VENICE_API_KEY="..."

# Netmind AI (OPTIONAL - Fallback image provider)
# Used when Venice API fails or runs out of credits
NETMIND_API_KEY="..."

# Base Network RPC (REQUIRED for blockchain interactions)
# Server-side only - not exposed to client
BASE_RPC_URL="https://mainnet.base.org"

# Optional: Client-side RPC URL (if different from server-side)
# NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"

# Neynar API (REQUIRED for Farcaster features)
NEYNAR_API_KEY="..."

# IPFS metadata uploads for Story Protocol registration
# Pinata is primary; Grove immutable uploads are the fallback.
PINATA_JWT="pina_..."
IPFS_GATEWAY="https://gateway.pinata.cloud"
GROVE_CHAIN_ID="8453"

# WalletConnect (REQUIRED for browser wallet support)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="..."

# Smart Contract Addresses (already public in code)
NEXT_PUBLIC_GAME_NFT_ADDRESS="0x778C87dAA2b284982765688AE22832AADae7dccC"
NEXT_PUBLIC_WRITER_COIN_PAYMENT_ADDRESS="0xf11822F99FF5f6982d42d4A0923d2b3f9589fA75"
NEXT_PUBLIC_GAME_NFT_CHAIN_ID="8453"

# NextAuth (optional, for future session management)
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ============================================
# Etherfuse Ramp API (Fiat Onramp)
# ============================================
# Get your API key from https://app.etherfuse.com
ETHERFUSE_API_KEY="your-etherfuse-api-key"
ETHERFUSE_API_URL="https://api.etherfuse.com"
ETHERFUSE_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# SuperRare NFT Minting
# ============================================
SUPERRARE_API_KEY="your-superrare-api-key"
SUPERRARE_API_URL="https://api.superrare.com"
SUPERRARE_CONTRACT_ADDRESS="0xb932a70a57673d89f4acffbe830e8ed7f75fb9e0"
