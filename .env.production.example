# Production Environment Variables for Vercel
# Copy these to your Vercel project settings: https://vercel.com/[your-project]/settings/environment-variables

# Site URL (REQUIRED for social media sharing)
NEXT_PUBLIC_SITE_URL="https://writarcade.vercel.app"
NEXT_PUBLIC_ANALYTICS_ENDPOINT="/api/analytics"

# Database (REQUIRED)
# For serverless (Vercel), use connection pooling:
# Example with Neon: postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Direct database URL for migrations (bypasses connection pooler)
# DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# AI Services (REQUIRED for game generation)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
VENICE_API_KEY="..."

# Netmind AI (OPTIONAL - Fallback image provider)
# Used when Venice API fails or runs out of credits
NETMIND_API_KEY="..."

# Base Network RPC (REQUIRED for blockchain interactions)
# Server-side only - not exposed to client
BASE_RPC_URL="https://mainnet.base.org"

# Optional: Client-side RPC URL (if different from server-side)
# NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"

# Neynar API (REQUIRED for Farcaster features)
NEYNAR_API_KEY="..."

# IPFS metadata uploads for Story Protocol registration
# Pinata is primary; Grove immutable uploads are the fallback.
PINATA_JWT="pina_..."
IPFS_GATEWAY="https://gateway.pinata.cloud"
GROVE_CHAIN_ID="8453"

# WalletConnect (REQUIRED for browser wallet support)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="..."

# Smart Contract Addresses (public on-chain — safe to commit)
NEXT_PUBLIC_GAME_NFT_ADDRESS="0x32D0356f533cC429F94Db73f383bBb21a459E16b"
NEXT_PUBLIC_GAME_NFT_MAINNET="0x32D0356f533cC429F94Db73f383bBb21a459E16b"
NEXT_PUBLIC_WRITER_COIN_PAYMENT_ADDRESS="0x56Ee5A3f122da00B635DdbB319708e24450aEB89"
NEXT_PUBLIC_WRITER_COIN_PAYMENT_MAINNET="0x56Ee5A3f122da00B635DdbB319708e24450aEB89"
NEXT_PUBLIC_GAME_NFT_CHAIN_ID="8453"

# Inco vaults (Base mainnet)
FEATURE_INCO="true"
FEATURE_DAILY_CHALLENGE="true"
NEXT_PUBLIC_INCO_NETWORK="baseMainnet"
NEXT_PUBLIC_SECRET_PANEL_VAULT_ADDRESS="0x36a3931f1acb69033f98e6eb8c3aa7d59cc6e5e8"
NEXT_PUBLIC_DAILY_CHALLENGE_VAULT_ADDRESS="0xcc271a53e4286012f3289273fdaa32f66fa64a33"

# Server wallet with VAULT_MANAGER_ROLE + SESSION_MANAGER_ROLE (NEVER commit the key)
# Reuse STORY_PLATFORM_PRIVATE_KEY in Vercel if it holds the roles, or set:
# INCO_VAULT_MANAGER_PRIVATE_KEY="0x..."
# DAILY_CHALLENGE_MANAGER_PRIVATE_KEY="0x..."

# Vercel Cron auth for GET /api/daily-challenge/setup (generate: openssl rand -hex 32)
CRON_SECRET="generate-a-random-secret"

# Auth session secret (REQUIRED) — HMAC key for signing wallet_session cookies
# Generate one with: openssl rand -hex 32
AUTH_SECRET="generate-a-random-secret-min-16-chars"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ============================================
# Etherfuse Ramp API (Fiat Onramp)
# ============================================
# Get your API key from https://app.etherfuse.com
ETHERFUSE_API_KEY="your-etherfuse-api-key"
ETHERFUSE_API_URL="https://api.etherfuse.com"
ETHERFUSE_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# SuperRare NFT Minting
# ============================================
SUPERRARE_API_KEY="your-superrare-api-key"
SUPERRARE_API_URL="https://api.superrare.com"
SUPERRARE_CONTRACT_ADDRESS="0xb932a70a57673d89f4acffbe830e8ed7f75fb9e0"

# ============================================
# Inco — Confidential Compute for Secret Panels
# ============================================
# Replaces Lit Protocol + Story CDR. Runs on Base mainnet.
FEATURE_INCO="true"
NEXT_PUBLIC_INCO_NETWORK="baseMainnet"
NEXT_PUBLIC_SECRET_PANEL_VAULT_ADDRESS="0x36a3931f1acb69033f98e6eb8c3aa7d59cc6e5e8"
# Server wallet private key with VAULT_MANAGER_ROLE — set in Vercel only, never commit
# INCO_VAULT_MANAGER_PRIVATE_KEY="0x..."

# ============================================
# Daily Challenge
# ============================================
FEATURE_DAILY_CHALLENGE="true"
# Client-visible flag (required for /daily page + banners in the browser bundle)
NEXT_PUBLIC_FEATURE_DAILY_CHALLENGE="true"
NEXT_PUBLIC_DAILY_CHALLENGE_VAULT_ADDRESS="0xcc271a53e4286012f3289273fdaa32f66fa64a33"
# Vercel Cron bearer token for GET /api/daily-challenge/setup
# CRON_SECRET="openssl rand -hex 32"
