{
  "name": "writarcade",
  "version": "1.0.0",
  "description": "Turn articles into mintable games - Next.js 16 migration",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "start": "next start",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma db push",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "repair:game-funding": "node scripts/repair-game-funding.mjs",
    "deploy:api": "bash scripts/deploy-writersarcade-api.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.55",
    "@ai-sdk/google": "^3.0.21",
    "@ai-sdk/openai": "^0.0.66",
    "@atproto/api": "0.19.5",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@inco/lightning-js": "1.0.2",
    "@mezo-org/passport": "0.17.2",
    "@paragraph_xyz/sdk": "^0.0.13",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@sentry/nextjs": "10.62.0",
    "@story-protocol/core-sdk": "^1.4.4",
    "@tanstack/react-query": "5.90.10",
    "ai": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.454.0",
    "marked": "^14.1.3",
    "next": "16.2.6",
    "pdfmake": "0.3.11",
    "pino-pretty": "^13.1.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.2",
    "react-dom": "19.2.2",
    "sharp": "^0.33.5",
    "siwe": "3.0.0",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^11.0.3",
    "viem": "2.48.8",
    "wagmi": "^2.19.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.8.6",
    "@types/node-fetch": "^2.6.13",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-react-hooks": "7.0.1",
    "ignore-loader": "^0.1.2",
    "jsdom": "29.1.1",
    "mysql2": "^3.15.3",
    "pg": "^8.12.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": "20.x"
  },
  "pnpm": {
    "overrides": {
      "@base-org/account": "2.4.0",
      "@coinbase/wallet-sdk": "3.9.3",
      "@rainbow-me/rainbowkit": "2.2.11",
      "viem": "2.48.8",
      "ox": "0.14.20"
    },
    "patchedDependencies": {
      "@gelatonetwork/relay-sdk@5.7.0": "patches/@gelatonetwork__relay-sdk@5.7.0.patch"
    }
  }
}
