# Database
# Required for production - set to your production database URL (e.g., Neon, Railway, etc.)
# Example for Neon: postgresql://username:password@ep-example-123.us-east-1.aws.neon.tech/writarcade?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/writarcade"

# Site URL (Client-side)
# Used for OpenGraph and Twitter Card meta tags
# Set to your production domain (e.g., https://writarcade.vercel.app)
NEXT_PUBLIC_SITE_URL="https://writarcade.vercel.app"
NEXT_PUBLIC_ANALYTICS_ENDPOINT="/api/analytics"

# Neynar API (Server-side only - DO NOT expose to client)
# Used in /api/farcaster/profile for Farcaster user profile lookup
NEYNAR_API_KEY="your-neynar-api-key"

# WalletConnect Project ID (Client-side)
# Used in Web3Provider for RainbowKit wallet connections
# Get this from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="your-walletconnect-project-id"

# Smart Contract Addresses (safe to expose - read-only)
# Used in lib/contracts.ts for contract interactions

# Base Sepolia (Testnet)
NEXT_PUBLIC_WRITER_COIN_PAYMENT_SEPOLIA="0x..."
NEXT_PUBLIC_GAME_NFT_SEPOLIA="0x..."

# Base Mainnet (Production)
NEXT_PUBLIC_WRITER_COIN_PAYMENT_MAINNET="0xf11822F99FF5f6982d42d4A0923d2b3f9589fA75"
NEXT_PUBLIC_GAME_NFT_MAINNET="0x778C87dAA2b284982765688AE22832AADae7dccC"
NEXT_PUBLIC_WRITER_COIN_PAYMENT_ADDRESS="0xf11822F99FF5f6982d42d4A0923d2b3f9589fA75"
NEXT_PUBLIC_GAME_NFT_ADDRESS="0x778C87dAA2b284982765688AE22832AADae7dccC"

# Network Chain IDs (safe to expose)
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID="84532"
NEXT_PUBLIC_BASE_MAINNET_CHAIN_ID="8453"

# ============================================
# Mezo Network (Bitcoin-backed MUSD payments)
# ============================================
# Mezo Matsnet (testnet) chainId: 31611
# Public RPC: https://rpc.test.mezo.org (default if override not set)
# Override RPC if you have a dedicated hackathon endpoint:
NEXT_PUBLIC_MEZO_TESTNET_RPC=""

# Deployed MezoPaymentSplitter contract addresses (safe to expose - read-only)
# Override the bundled defaults if you redeploy.
NEXT_PUBLIC_MEZO_PAYMENT_SPLITTER_TESTNET="0x32D0356f533cC429F94Db73f383bBb21a459E16b"
NEXT_PUBLIC_MEZO_PAYMENT_SPLITTER_MAINNET=""

# Server-side only - DO NOT commit. Used by scripts/deploy-mezo.sh
# A funded Mezo testnet wallet (gas in BTC, plus MUSD for end-to-end tests)
MEZO_DEPLOYER_PRIVATE_KEY=""
# Address that receives the platform's share of MUSD payments
PLATFORM_TREASURY_ADDRESS=""
# Mezo testnet MUSD token (default in lib/writerCoins.ts MUSD_CONFIG.testnet.address)
MEZO_TESTNET_MUSD_ADDRESS="0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503"

# Venice AI API Key (Server-side only - DO NOT expose to client)
# Used in /api/generate-image for secure image generation
VENICE_API_KEY="your-venice-api-key"

# Netmind AI API Key (Server-side only - Fallback image provider)
# Used when Venice API fails or runs out of credits
# Get this from https://docs.netmind.ai/
NETMIND_API_KEY="your-netmind-api-key"

# Modal Image Generation (Server-side only - Self-hosted fallback)
# Your deployed Modal endpoint for Stable Diffusion image generation
# Deploy with: cd scripts/modal && modal deploy modal_image_gen.py
# IMPORTANT: Keep this URL private! Anyone with it can use your GPU credits.
# Get your URL from Modal dashboard after deployment
MODAL_IMAGE_GEN_URL="your-modal-endpoint-url-here"

# Google AI API Key (Server-side only - DO NOT expose to client)
# Used for Gemini 3 integration (optional - users can BYOK)
GOOGLE_API_KEY="your-google-ai-api-key"

# Story Protocol Integration (Client-Side)
# Users sign IP registration with their own wallets (no server keys needed)
# Faucet for testnet tokens: https://faucet.story.foundation/

# Story Protocol Network ("testnet" or "mainnet")
# Testnet Chain ID: 1315 (Aeneid)
# Mainnet Chain ID: 1513
NEXT_PUBLIC_STORY_NETWORK="testnet"

# Server-side platform key for Story CDR vaulting
# DO NOT expose to client. Needs to be funded with Story testnet ETH for gas.
# IMPORTANT: Set this on the PM2 backend server (snel-bot:/opt/writersarcade-api/shared/.env),
# NOT in Vercel. The backend handles the 5.5 MB CDR WASM module.
STORY_PLATFORM_PRIVATE_KEY="your-platform-private-key"

# SPG (Story Protocol Gateway) Contract for fast minting
# Default testnet: 0xc32A8a0FF3beDDDa58393d022aF433e78739FAbc
NEXT_PUBLIC_STORY_SPG_CONTRACT="0xc32A8a0FF3beDDDa58393d022aF433e78739FAbc"

# Enable/disable Story Protocol UI (for development)
NEXT_PUBLIC_STORY_ENABLED="true"

# IPFS Storage (for game/asset metadata)
# Using Pinata - https://www.pinata.cloud
PINATA_JWT="your-pinata-jwt-token"
IPFS_GATEWAY="https://gateway.pinata.cloud"

# Story-API REST endpoint for CDR DKG state (NOT the EVM RPC)
# Used by CDR backend for querying validator partials and DKG keys.
# NEXT_PUBLIC_ prefix is required so the browser bundle can reach the CDR API
# for client-side accessCDR() decryption calls.
NEXT_PUBLIC_CDR_API_URL="http://172.192.41.96:1317"
CDR_API_URL="http://172.192.41.96:1317"

# CDR Backend URL — base URL for the Hetzner Fastify vault server.
# Must match the nginx reverse proxy config (includes /writersarcade prefix).
# Used by server-side vaultViaBackend() and NFT ownership verification proxy.
CDR_BACKEND_URL="https://api.snel.famile.xyz/writersarcade"

# OpenAI API Key (Server-side only - DO NOT expose to client)
# Used for AI text generation and TTS (Text-to-Speech) narration
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# ElevenLabs API Key (Server-side only - OPTIONAL)
# Premium TTS provider for higher quality voice narration
# Get this from https://elevenlabs.io
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_DEFAULT_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# ============================================
# Lit Protocol (NFT-Gated Secret Panels)
# ============================================
# Encrypts game epilogues so only NFT holders can decrypt.
# Set to "false" to disable (uses base64 fallback in dev)
LIT_PROTOCOL_ENABLED="true"

# Lit Network: "datil-dev" (free dev), "datil-test", or "datil" (production)
LIT_NETWORK="datil-dev"
LIT_RPC_URL="https://lit-protocol-datil-dev.rpc.litgateway.com"

# ============================================
# Hypercerts (Impact Certificates via AT Protocol)
# ============================================
# Creates impact certificates for game creation.
# Set to "false" to disable (uses mock URIs in dev)
HYPERCERTS_ENABLED="true"

# AT Protocol credentials (from certified.app)
# Without these, mock URIs are generated for development
HYPERCERTS_HANDLE="your-handle.certified.app"
HYPERCERTS_APP_PASSWORD="your-app-password"
HYPERCERTS_PDS_URL="https://certified.app"

# Hugging Face Inference API (free tier available)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
